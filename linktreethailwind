<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Meu Linktree</title>

    
    <script src="https://cdn.tailwindcss.com"></script>

    
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-purple-900 via-indigo-900 to-slate-950 text-white">

    
    <main class="min-h-screen flex justify-center px-4 py-10">

        <div class="w-full max-w-md text-center">

            
            <div class="flex justify-center mb-5">
                <div class="w-28 h-28 rounded-full bg-gradient-to-r from-purple-400 to-pink-500 p-1 shadow-2xl">
                    <img
                        src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=300"
                        alt="Foto de perfil"
                        class="w-full h-full rounded-full object-cover border-4 border-slate-950"
                    >
                </div>
            </div>

            <!-- Nome -->
            <h1 class="text-2xl font-bold">
                Alex Dev
            </h1>

            
            <p class="text-gray-300 mt-2 mb-6">
                💻 Desenvolvedor | 🎓 ADS | 🚀 Tecnologia
            </p>

            
            <div class="flex justify-center gap-5 mb-8">

                <a
                    href="#"
                    class="hover:text-purple-400 transition transform hover:scale-110"
                    title="GitHub"
                >
                    <i data-lucide="github" class="w-6 h-6"></i>
                </a>

                <a
                    href="#"
                    class="hover:text-blue-400 transition transform hover:scale-110"
                    title="LinkedIn"
                >
                    <i data-lucide="linkedin" class="w-6 h-6"></i>
                </a>

                <a
                    href="#"
                    class="hover:text-pink-400 transition transform hover:scale-110"
                    title="Instagram"
                >
                    <i data-lucide="instagram" class="w-6 h-6"></i>
                </a>

                <a
                    href="#"
                    class="hover:text-green-400 transition transform hover:scale-110"
                    title="WhatsApp"
                >
                    <i data-lucide="message-circle" class="w-6 h-6"></i>
                </a>

            </div>

            
            <div class="space-y-4">

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-4 px-6 rounded-xl font-semibold shadow-lg hover:bg-gray-100 hover:scale-[1.02] transition"
                >
                    <i data-lucide="github" class="w-5 h-5"></i>
                    Meu GitHub
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-4 px-6 rounded-xl font-semibold shadow-lg hover:bg-gray-100 hover:scale-[1.02] transition"
                >
                    <i data-lucide="linkedin" class="w-5 h-5"></i>
                    Meu LinkedIn
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-4 px-6 rounded-xl font-semibold shadow-lg hover:bg-gray-100 hover:scale-[1.02] transition"
                >
                    <i data-lucide="instagram" class="w-5 h-5"></i>
                    Meu Instagram
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-4 px-6 rounded-xl font-semibold shadow-lg hover:bg-gray-100 hover:scale-[1.02] transition"
                >
                    <i data-lucide="briefcase" class="w-5 h-5"></i>
                    Meu Portfólio
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-4 px-6 rounded-xl font-semibold shadow-lg hover:bg-gray-100 hover:scale-[1.02] transition"
                >
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                    Meu Currículo
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center gap-3 w-full bg-gradient-to-r from-purple-500 to-pink-500 py-4 px-6 rounded-xl font-semibold shadow-lg hover:scale-[1.02] transition"
                >
                    <i data-lucide="mail" class="w-5 h-5"></i>
                    Entre em contato
                </a>

            </div>

            
            <footer class="mt-10 text-sm text-gray-400">
                <p>© 2026 Alex Dev</p>
                <p class="mt-1">Feito com ❤️ e Tailwind CSS</p>
            </footer>

        </div>

    </main>

    
    <script>
        lucide.createIcons();
    </script>

</body>
</html>
